<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="report_active_ewaybill_document">
            <t t-call="web.basic_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.user_id.lang)"/>
                <table width="100%"
                       style="text-align: left; border-collapse: collapse; border: 1px solid #EEEEEE; margin: 0; border-radius: 5px;">
                    <tr>
                        <td style="border: none; padding: 10px;">
                            <table width="100%"
                                   style="text-align: left; border-collapse: collapse; border: 1px solid #FFFFFF; margin: 0;">
                                <thead>
                                    <tr>
                                        <th width="80%">
                                            <span style="font-family: arial;font-size: 20px; font-weight: bold;">
                                                e-Way Bill
                                            </span>
                                        </th>
                                        <th width="20%"
                                            style="text-align: right; border-collapse: collapse; border: 1px solid #FFFFFF; margin: 0;">
                                            <img t-attf-src="data:image/*;base64,{{doc.get_eway_qr_code}}"
                                                 style="height:150px; width:150px;"/>
                                        </th>
                                    </tr>
                                </thead>
                            </table>
                            <!--                            1.e-way bill Details-->
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="100%">
                                        <br></br>
                                        <strong style="font-family: arial;font-size: 14px;">1. E-WAY BILL Details
                                        </strong>
                                        <br></br>
                                    </td>
                                </tr>
                            </table>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="30%">
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            eWay Bill No:
                                        </span>
                                        <span t-field="doc.get_ewbNo"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                        <br></br>
                                    </td>
                                    <td width="35%">
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            Generated Date:
                                        </span>
                                        <span t-field="doc.get_ewayBillDate"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                        <br></br>
                                    </td>
                                    <td width="35%">
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            Generated By:
                                        </span>
                                        <span t-field="doc.get_userGstin"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            Valid Upto:
                                        </span>
                                        <span t-field="doc.get_validUpto"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                    </td>
                                </tr>
                            </table>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="50%">
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            Mode:
                                        </span>
                                        <!--                                        <span t-field="doc.transportation_mode"-->
                                        <!--                                              style="font-family: serif; font-size: 14px; font-weight: bold;"/>-->
                                    </td>
                                    <td width="50%">
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            Approx Distance:
                                        </span>
                                        <span t-esc="doc.get_actualDist or 'N/A'"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            KM
                                        </span>
                                    </td>
                                </tr>
                            </table>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="30%">
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            Type:
                                        </span>
                                        <span t-field="doc.get_supplyType"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                        <span>
                                            -
                                        </span>
                                        <span t-field="doc.get_subSupplyType"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                    </td>
                                    <td width="35%">
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            Document Details:
                                        </span>
                                        <span t-field="doc.get_docType"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                        <span>
                                            -
                                        </span>
                                        <span t-field="doc.get_docNo"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                        <span>
                                            -
                                        </span>
                                        <span t-field="doc.get_docDate"
                                              style="font-family: arial;font-size: 12px; font-weight: bold;"/>
                                    </td>
                                    <td width="35%">
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            Transaction type:
                                        </span>
                                        <span t-field="doc.get_transactionType"
                                              style="font-family: arial;font-size: 12px;font-weight: bold;"/>
                                    </td>
                                </tr>
                            </table>
                            <!--                            2.Address Details-->
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <br></br>
                                    <td width="100%">
                                        <strong style="font-family: arial;font-size: 14px;font-weight: bold;">2.Address
                                            Details
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="50%">
                                        <span style="font-family: arial;font-size: 14px;font-weight: bold;">
                                            From
                                        </span>
                                        <br></br>
                                        <br></br>
                                        <span style="font-family: arial; font-size: 12px; font-weight: normal;">
                                            GSTIN:
                                        </span>
                                        <span t-field="doc.get_billfrom_Gstin"
                                              style="font-family: arial; font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <span t-field="doc.get_billfrom_TrdName"
                                              style="font-family: arial; font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <span t-field="doc.get_billfrom_state"
                                              style="font-family: arial; font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <br></br>
                                        <span style="font-family: arial; font-size: 12px; font-weight: normal;">
                                            :: Dispatch From ::
                                        </span>
                                        <br></br>
                                        <span t-field="doc.get_dispatch_fromAddr1"
                                              style="font-family: arial; font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <span t-field="doc.get_dispatch_fromAddr2"
                                              style="font-family: arial; font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <span t-field="doc.get_dispatch_fromPlace"
                                              style="font-family: arial; font-size: 12px; font-weight: normal;"/>
                                        <span t-field="doc.get_dispatch_fromStateCode"
                                              style="font-family: arial; font-size: 12px; font-weight: normal;"/>
                                        <span>
                                            -
                                        </span>
                                        <span t-field="doc.get_dispatch_fromPincode"
                                              style="font-family: arial; font-size: 12px; font-weight: normal;"/>
                                    </td>
                                    <td width="50%">
                                        <span style="font-family: arial;font-size: 14px;font-weight: bold;">
                                            To
                                        </span>
                                        <br></br>
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            GSTIN:
                                        </span>
                                        <span t-field="doc.get_billto_Gstin"
                                              style="font-family: arial;font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <span t-field="doc.get_billto_TrdName"
                                              style="font-family: arial;font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <span t-field="doc.get_billto_StateCode"
                                              style="font-family: arial;font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <br></br>
                                        <span style="font-family: arial;font-size: 12px; font-weight: normal;">
                                            :: Ship To ::
                                        </span>
                                        <br></br>
                                        <span t-field="doc.get_shipto_Addr1"
                                              style="font-family: arial;font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <span t-field="doc.get_shipto_Addr2"
                                              style="font-family: arial;font-size: 12px; font-weight: normal;"/>
                                        <br></br>
                                        <span t-field="doc.get_shipto_Place"
                                              style="font-family: arial;font-size: 12px; font-weight: normal;"/>
                                        <span t-field="doc.get_shipto_StateCode"
                                              style="font-family: arial;font-size: 12px; font-weight: normal;"/>
                                        <span>
                                            -
                                        </span>
                                        <span t-field="doc.get_shipto_Pincode"
                                              style="font-family: arial;font-size: 12px; font-weight: normal;"/>
                                    </td>
                                </tr>
                            </table>
                            <!--                            3. Goods Details-->
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <br></br>
                                    <td width="100%">
                                        <strong style="font-family: arial;font-size: 14px;font-weight: bold;">3. Goods
                                            Details
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <thead>
                                    <br></br>
                                    <tr>
                                        <!-- Product details column -->
                                        <th name="th_hsn_code"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            HSN
                                            Code
                                        </th>
                                        <th name="th_label"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Product Name and Desc.
                                        </th>
                                        <th name="th_quantity"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Quantity
                                        </th>
                                        <th name="th_taxableamount"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Taxable Amount Rs.
                                        </th>
                                        <th name="th_tax"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Tax Rate
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.products_id" t-as="line">
                                        <tr>
                                            <td name="th_hsn_code"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: left; padding: 5px; border: 1px solid #EEEEEE;">
                                                <span t-field="line.get_eway_hsnCode"/>
                                            </td>
                                            <td name="th_label"
                                                style="font-family: arial; font-size: 12px;font-weight: normal;padding: 5px;text-align: left;">
                                                <span t-field="line.get_eway_productName"/>
                                            </td>
                                            <td name="th_quantity"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: left; padding: 5px; border: 1px solid #EEEEEE;">
                                                <span t-field="line.get_eway_quantity"/>
                                                <span t-field="line.get_eway_qtyUnit"/>
                                            </td>
                                            <td name="th_taxableamount" class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                <span t-field="line.get_eway_taxableAmount"/>
                                            </td>
                                            <td name="th_tax" class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                   <span style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right;">
                                                        0+0+0.000+0+0
                                                   </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <br></br>
                            <!--                            Totals-->
                            <table width="100%" style="border: 1px solid #EEEEEE;">
                                <thead>
                                    <tr>
                                        <th id="th_taxable_amt"
                                            style="font-family: arial;font-size: 14px; font-weight: bold; text-align: center;">
                                            <strong>Tot. Tax'ble Amt</strong>
                                        </th>
                                        <th id="th_cgst"
                                            style="font-family: arial;font-size: 14px; font-weight: bold; text-align: center;">
                                            CGST Amt
                                        </th>
                                        <th id="th_sgst"
                                            style="font-family: arial;font-size: 14px; font-weight: bold; text-align: center;">
                                            SGST Amt
                                        </th>
                                        <th id="th_igst"
                                            style="font-family: arial;font-size: 14px; font-weight: bold; text-align: center;">
                                            IGST Amt
                                        </th>
                                        <th id="th_cess"
                                            style="font-family: arial;font-size: 14px; font-weight: bold; text-align: center;">
                                            CESS Amt
                                        </th>
                                        <th id="th_cess_non"
                                            style="font-family: arial;font-size: 14px; font-weight: bold; text-align: center;">
                                            CESS Non.Advol Amt
                                        </th>
                                        <th id="th_other"
                                            style="font-family: arial;font-size: 14px; font-weight: bold; text-align: center;">
                                            Other Amt
                                        </th>
                                        <th id="th_total"
                                            style="font-family: arial;font-size: 14px; font-weight: bold; text-align: center;">
                                            Total Inv.Amt
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td id="td_taxable_amt"
                                            style="font-family: arial;font-size: 12px;font-weight: normal;text-align:right;">
                                            <span t-field="doc.get_totalValue"/>
                                        </td>
                                        <td id="td_cgst"
                                            style="font-family: arial;font-size: 12px;font-weight: normal;text-align:right;">
                                            <span t-field="doc.get_cgstValue"/>
                                        </td>
                                        <td id="td_sgst"
                                            style="font-family: arial;font-size: 12px;font-weight: normal;text-align:right;">
                                            <span t-field="doc.get_sgstValue"/>
                                        </td>
                                        <td id="td_igst"
                                            style="font-family: arial;font-size: 12px;font-weight: normal;text-align:right;">
                                            <span t-field="doc.get_igstValue"/>
                                        </td>
                                        <td id="th_cess"
                                            style="font-family: arial;font-size: 12px;font-weight: normal;text-align:right;">
                                            <span t-field="doc.get_cessValue"/>
                                        </td>
                                        <td id="th_cess_non"
                                            style="font-family: arial;font-size: 12px;font-weight: normal;text-align:right;">
                                            <span t-field="doc.get_cessNonAdvolValue"/>
                                        </td>
                                        <td id="th_other"
                                            style="font-family: arial;font-size: 12px;font-weight: normal;text-align:right;">
                                            <span t-field="doc.get_otherValue"/>
                                        </td>
                                        <td id="td_total"
                                            style="font-family: arial;font-size: 12px;font-weight: normal;text-align:right;">
                                            <span t-field="doc.get_totInvValue"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <!--                            Transportation Details-->
                            <br></br>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="100%">
                                        <strong style="font-family: arial;font-size: 14px;font-weight: bold;">4.
                                            Transportation Details
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="50%">
                                        <span style="font-family: arial; font-size: 12px; font-weight: normal;">
                                            Transporter ID &amp; Name :
                                        </span>
                                        <span t-field="doc.get_transporterId"
                                              style="font-family: arial; font-size: 12px; font-weight: bold;"/>
                                        <span t-field="doc.get_transporterName"
                                              style="font-family: arial; font-size: 12px; font-weight: bold;"/>
                                    </td>
                                    <td width="50%">
                                        <span style="font-family: arial; font-size: 12px; font-weight: normal;">
                                            Transporter Doc. No &amp; Date :
                                        </span>
                                        <span t-field="doc.get_docNo"
                                              style="font-family: arial; font-size: 12px; font-weight: bold;"/>
                                        <span t-field="doc.get_docDate"
                                              style="font-family: arial; font-size: 12px; font-weight: bold;"/>
                                    </td>
                                </tr>
                            </table>
                            <!--                            Vehicle Details-->
                            <br></br>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="100%">
                                        <strong style="font-family: arial;font-size: 14px;">5. Vehicle Details</strong>
                                    </td>
                                </tr>
                            </table>
                            <table width="100%" style="text-align: left; border: 1px solid #EEEEEE;">
                                <thead>
                                    <tr>
                                        <!-- Product details column -->
                                        <th name="th_mode"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Mode
                                        </th>
                                        <th name="th_trans"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Vehicle / Trans Doc No and Dt.
                                        </th>
                                        <th name="th_from"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            From
                                        </th>
                                        <th name="th_enter_date"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Entered Date
                                        </th>
                                        <th name="th_enter_by"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Entered By
                                        </th>
                                        <th name="th_cewb"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            CEWB No.
                                            (If any)
                                        </th>
                                        <th name="th_multi"
                                            style="font-family: arial;font-size: 14px; font-weight: bold;text-align: center; padding: 5px; border: 1px solid #EEEEEE;">
                                            Multi Veh.Info
                                            (If any)
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.vehicles_id" t-as="vehicle">
                                        <tr>
                                            <td class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                <span t-field="vehicle.get_veh_transMode" style="font-weight: bold;"/>
                                            </td>
                                            <td class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                <span t-field="vehicle.get_veh_vehicleNo"/>
                                                <span t-field="vehicle.get_veh_transDocNo"/>
                                                <span t-field="vehicle.get_veh_transDocDate"/>
                                            </td>
                                            <td class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                <span t-field="vehicle.get_veh_fromPlace"/>
                                            </td>
                                            <td class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                <span t-field="vehicle.get_veh_enteredDate"/>
                                            </td>
                                            <td name="th_enter_by" class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                <span t-field="vehicle.get_veh_userGSTINTransin"/>
                                            </td>
                                            <td name="th_cewb" class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                <span>
                                                    -
                                                </span>
                                            </td>
                                            <td name="th_multi" class="text-end"
                                                style="font-family: arial; font-size: 12px; font-weight: normal; text-align: right; padding: 5px; border:1px solid #EEEEEE;">
                                                <span>
                                                    -
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <table width="100%" style="text-align: center; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="100%">
                                        <br></br>
                                        <img t-attf-src="data:image/*;base64,{{doc.get_eway_barcode}}"
                                             style="height:50px;width:150px;"/>
                                        <br></br>
                                        <span t-field="doc.get_ewbNo"/>
                                    </td>
                                </tr>
                            </table>
                            <table width="100%" style="text-align: center; border: 1px solid #EEEEEE;">
                                <tr>
                                    <td width="100%"
                                        style="font-family: arial; font-size: 12px; font-weight: normal; text-align: left; padding: 5px; border:1px solid #EEEEEE;">
                                        <span>
                                            Note*: If any discrepancy in information please try after sometime.
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </t>
        </template>


        <template id="report_active_eway_bill_pdf">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="consolidate_eway_bill_addons.report_active_ewaybill_document" t-lang="doc.user_id.lang"/>
                </t>
            </t>
        </template>
    </data>
</odoo>