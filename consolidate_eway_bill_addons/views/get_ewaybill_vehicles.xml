<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="get_ewaybill_vehicles_form_view" model="ir.ui.view">
        <field name="name">get.ewaybill.vehicle.form.view</field>
        <field name="model">get.ewaybill.vehicles</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                       <h1>
                            <field name="name" readonly="1"/>
                       </h1>
                    </div>
                    <group>
                         <group string="Created By">
                            <field name="company_id" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="created_date" readonly="1"/>
                        </group>
                        <group string="Transport Info">
                            <field name="get_veh_transMode" readonly="1"/>
                            <field name="get_veh_vehicleNo" readonly="1"/>
                            <field name="get_veh_fromPlace" readonly="1"/>
                            <field name="get_veh_fromState" readonly="1"/>
                        </group>
                        <group string="Date Info">
                            <field name="get_veh_tripshtNo" readonly="1"/>
                            <field name="get_veh_userGSTINTransin" readonly="1"/>
                            <field name="get_veh_enteredDate" readonly="1"/>
                            <field name="get_veh_transDocNo" readonly="1"/>
                        </group>
                        <group string="Documents Info">
                            <field name="get_veh_transDocDate" readonly="1"/>
                            <field name="get_veh_groupNo" readonly="1"/>
                            <field name="get_veh_updMode" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                 <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>


    <record id="get_ewaybill_vehicles_tree_view" model="ir.ui.view">
        <field name="name">get.ewaybill.vehicle.tree.view</field>
        <field name="model">get.ewaybill.vehicles</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="created_date"/>
                <field name="company_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="get_veh_transMode"/>
                <field name="get_veh_vehicleNo"/>
                <field name="get_veh_fromPlace"/>
                <field name="get_veh_fromState"/>
                <field name="get_veh_userGSTINTransin"/>
                <field name="get_veh_enteredDate"/>
                <field name="get_veh_transDocNo"/>
                <field name="get_veh_transDocDate"/>
                <field name="get_veh_updMode"/>
            </tree>
        </field>
    </record>

    <record id="action_get_ewaybill_vehicles" model="ir.actions.act_window">
        <field name="name">Vehicles Logs</field>
        <field name="res_model">get.ewaybill.vehicles</field>
        <field name="view_mode">tree,form,pivot</field>
    </record>


    <menuitem id="get_ewaybill_vehicles"
              name="Vehicles Logs"
              action="action_get_ewaybill_vehicles"
              parent="get_ewaybill_root"
              sequence="15"/>

</odoo>