<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_lock_inherit" model="ir.ui.view">
        <field name="name">repair.order.form.lock.inherit</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <!-- Ensure move_ids logic includes done/cancel for readonly if not already (it is, but reinforcing) -->
            <!-- Adding Revoke Button -->
            <xpath expr="//header" position="inside">
                <button name="action_revoke_to_draft" 
                        string="Revoke to Draft" 
                        type="object" 
                        groups="odoo_lock_orders.group_allow_unlock_orders"
                        invisible="state == 'draft'"
                        class="btn-danger"
                        confirm="Are you sure you want to revoke this repair to Draft? This allows editing."/>
            </xpath>
        </field>
    </record>
</odoo>
