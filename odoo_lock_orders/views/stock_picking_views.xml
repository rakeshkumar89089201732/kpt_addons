<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_lock_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.lock.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Strict Lock: Make operations readonly in done/cancel states -->
            <!-- Note: Stock picking usually locks 'done' moves, but we reinforce it -->
            <xpath expr="//field[@name='move_ids_without_package']" position="attributes">
                <attribute name="readonly">state in ['done', 'cancel']</attribute>
            </xpath>
            
            <!-- Revoke Button -->
            <xpath expr="//header" position="inside">
                <button name="action_revoke_to_draft" 
                        string="Revoke to Draft" 
                        type="object" 
                        groups="odoo_lock_orders.group_allow_unlock_orders"
                        invisible="state == 'draft'"
                        class="btn-danger"
                        confirm="Are you sure you want to revoke this transfer to Draft? This allows editing but may affect inventory consistency."/>
            </xpath>
        </field>
    </record>
</odoo>
