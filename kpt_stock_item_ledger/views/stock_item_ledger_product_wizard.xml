<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_item_ledger_product_wizard_form" model="ir.ui.view">
        <field name="name">stock.item.ledger.product.wizard.form</field>
        <field name="model">stock.item.ledger.product.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Product">
                <group>
                    <field name="product_id" options="{'no_create': True}"/>
                    <field name="report_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Apply" type="object" name="action_apply_product" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
