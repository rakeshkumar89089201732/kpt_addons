<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Account report definition -->
        <record id="stock_item_ledger_report" model="account.report">
            <field name="name">Stock Item Ledger</field>
            <field name="filter_journals" eval="False"/>
            <field name="filter_analytic" eval="False"/>
            <field name="filter_period_comparison" eval="False"/>
            <field name="filter_multi_company">selector</field>
            <field name="filter_unfold_all" eval="True"/>
            <field name="filter_hide_0_lines">never</field>
            <field name="default_opening_date_filter">this_month</field>
            <field name="filter_date_range" eval="True"/>
            <field name="search_bar" eval="True"/>
            <field name="load_more_limit" eval="0"/>
            <field name="custom_handler_model_id" ref="model_kpt_stock_item_ledger_report_handler"/>
            <field name="column_ids">
                <record id="stock_item_ledger_col_date" model="account.report.column">
                    <field name="name">Date</field>
                    <field name="expression_label">date</field>
                    <field name="figure_type">date</field>
                </record>
                <record id="stock_item_ledger_col_document" model="account.report.column">
                    <field name="name">Document</field>
                    <field name="expression_label">document</field>
                    <field name="figure_type">string</field>
                </record>
                <record id="stock_item_ledger_col_partner" model="account.report.column">
                    <field name="name">Partner</field>
                    <field name="expression_label">partner_name</field>
                    <field name="figure_type">string</field>
                </record>
                <record id="stock_item_ledger_col_in_qty" model="account.report.column">
                    <field name="name">In Qty</field>
                    <field name="expression_label">in_qty</field>
                    <field name="figure_type">float</field>
                </record>
                <record id="stock_item_ledger_col_in_value" model="account.report.column">
                    <field name="name">In Value</field>
                    <field name="expression_label">in_value</field>
                    <field name="figure_type">monetary</field>
                </record>
                <record id="stock_item_ledger_col_out_qty" model="account.report.column">
                    <field name="name">Out Qty</field>
                    <field name="expression_label">out_qty</field>
                    <field name="figure_type">float</field>
                </record>
                <record id="stock_item_ledger_col_out_value" model="account.report.column">
                    <field name="name">Out Value</field>
                    <field name="expression_label">out_value</field>
                    <field name="figure_type">monetary</field>
                </record>
                <record id="stock_item_ledger_col_balance_qty" model="account.report.column">
                    <field name="name">Balance Qty</field>
                    <field name="expression_label">balance_qty</field>
                    <field name="figure_type">float</field>
                </record>
                <record id="stock_item_ledger_col_balance_value" model="account.report.column">
                    <field name="name">Balance Value</field>
                    <field name="expression_label">balance_value</field>
                    <field name="figure_type">monetary</field>
                </record>
            </field>
        </record>

        <!-- Action to open the report UI -->
        <record id="action_account_report_stock_item_ledger" model="ir.actions.client">
            <field name="name">Stock Item Ledger</field>
            <field name="tag">account_report</field>
            <field name="context" eval="{'report_id': ref('kpt_stock_item_ledger.stock_item_ledger_report')}"/>
        </record>

        <!-- Menu entry under Inventory / Reporting -->
        <menuitem id="menu_stock_item_ledger_report"
                  name="Stock Item Ledger"
                  parent="stock.menu_warehouse_report"
                  action="action_account_report_stock_item_ledger"
                  sequence="50"/>

        <!-- Menu entry under Accounting / Reporting -->
        <menuitem id="menu_stock_item_ledger_report_accounting"
                  name="Stock Item Ledger"
                  parent="account.menu_finance_reports"
                  action="action_account_report_stock_item_ledger"
                  sequence="85"/>

    </data>
</odoo>

