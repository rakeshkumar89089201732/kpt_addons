<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tds_certificate_tree" model="ir.ui.view">
        <field name="name">tds.certificate.tree</field>
        <field name="model">tds.certificate</field>
        <field name="arch" type="xml">
            <tree string="TDS Certificates">
                <field name="certificate_number"/>
                <field name="employee_id"/>
                <field name="financial_year"/>
                <field name="tds_deducted"/>
                <field name="certificate_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_tds_certificate_form" model="ir.ui.view">
        <field name="name">tds.certificate.form</field>
        <field name="model">tds.certificate</field>
        <field name="arch" type="xml">
            <form string="TDS Certificate">
                <header>
                    <button name="action_issue_certificate" type="object" string="Issue" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel_certificate" type="object" string="Cancel" class="btn-secondary" invisible="state == 'cancelled'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <button name="action_print_certificate" type="object" string="Print" class="btn-secondary" invisible="state != 'issued'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued,cancelled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="certificate_number" readonly="1"/>
                            <field name="employee_id"/>
                            <field name="employer_id"/>
                            <field name="financial_year"/>
                            <field name="assessment_year"/>
                        </group>
                        <group>
                            <field name="period_from"/>
                            <field name="period_to"/>
                            <field name="certificate_date"/>
                            <field name="issued_by" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Employer / Employee">
                            <group>
                                <group string="Employee">
                                    <field name="employee_pan" readonly="1"/>
                                    <field name="employee_address"/>
                                </group>
                                <group string="Employer">
                                    <field name="employer_pan" readonly="1"/>
                                    <field name="employer_tan" readonly="1"/>
                                    <field name="employer_address" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Income">
                            <group>
                                <group>
                                    <field name="gross_salary"/>
                                    <field name="allowances"/>
                                    <field name="perquisites"/>
                                    <field name="profits_in_lieu"/>
                                </group>
                                <group>
                                    <field name="total_income" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <page string="Deductions &amp; Tax">
                            <group>
                                <group>
                                    <field name="standard_deduction"/>
                                    <field name="entertainment_allowance"/>
                                    <field name="professional_tax"/>
                                    <field name="other_deductions"/>
                                    <field name="total_deductions" readonly="1"/>
                                </group>
                                <group>
                                    <field name="income_chargeable" readonly="1"/>
                                    <field name="tax_on_income"/>
                                    <field name="surcharge"/>
                                    <field name="cess"/>
                                    <field name="total_tax" readonly="1"/>
                                    <field name="tds_deducted"/>
                                </group>
                            </group>
                        </page>

                        <page string="Challans">
                            <field name="challan_ids" widget="many2many_tags"/>
                        </page>

                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tds_certificate" model="ir.actions.act_window">
        <field name="name">TDS Certificates</field>
        <field name="res_model">tds.certificate</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
