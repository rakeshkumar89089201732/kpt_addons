<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tds_challan_tree" model="ir.ui.view">
        <field name="name">tds.challan.tree</field>
        <field name="model">tds.challan</field>
        <field name="arch" type="xml">
            <tree string="TDS Challans">
                <field name="challan_number"/>
                <field name="challan_date"/>
                <field name="bank_name"/>
                <field name="financial_year"/>
                <field name="quarter"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_tds_challan_form" model="ir.ui.view">
        <field name="name">tds.challan.form</field>
        <field name="model">tds.challan</field>
        <field name="arch" type="xml">
            <form string="TDS Challan">
                <header>
                    <button name="action_deposit" type="object" string="Mark Deposited" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reconcile" type="object" string="Reconcile" class="btn-success" invisible="state != 'deposited'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state == 'reconciled'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,deposited,reconciled"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="challan_number"/>
                            <field name="challan_date"/>
                            <field name="bank_name"/>
                            <field name="bank_branch"/>
                        </group>
                        <group>
                            <field name="financial_year"/>
                            <field name="quarter"/>
                            <field name="assessment_year"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Challan Details">
                            <field name="challan_line_ids">
                                <tree editable="bottom">
                                    <field name="section_code"/>
                                    <field name="description"/>
                                    <field name="amount"/>
                                    <field name="employee_count"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_tax_deposited"/>
                                <field name="interest_amount"/>
                                <field name="penalty_amount"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="total_amount"/>
                                </div>
                                <field name="total_amount" nolabel="1" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="company_pan"/>
                                <field name="company_tan"/>
                                <field name="remarks"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tds_challan" model="ir.actions.act_window">
        <field name="name">TDS Challans</field>
        <field name="res_model">tds.challan</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
