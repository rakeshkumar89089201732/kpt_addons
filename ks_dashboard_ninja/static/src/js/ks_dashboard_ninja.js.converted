/** @odoo-module **/

import { Component, useState, onWillStart, onMounted, onWillUnmount } from "@odoo/owl";
import { registry } from "@web/core/registry";
import { useService } from "@web/core/utils/hooks";
import { _t } from "@web/core/l10n/translation";
import { Dialog } from "@web/core/dialog/dialog";
import { formatDateTime, formatDate } from "@web/core/l10n/dates";
import { session } from "@web/session";

export class KsDashboardNinja extends Component {
    static template = "ks_dashboard_ninja.ks_dashboard_ninja_template_view";
    
    setup() {
        this.orm = useService("orm");
        this.action = useService("action");
        this.dialog = useService("dialog");
        this.notification = useService("notification");
        this.rpc = useService("rpc");
        
        this.state = useState({
            ks_mode: 'active',
            ksIsDashboardManager: false,
            ksDashboardEditMode: false,
            ksNewDashboardName: false,
            ksAllowItemClick: true,
            ksDateFilterSelection: false,
            ksDateFilterStartDate: false,
            ksDateFilterEndDate: false,
        });

        // Dashboard configuration
        this.ks_dashboard_id = this.props.action.params?.ks_dashboard_id;
        this.controllerID = this.props.controllerID;
        this.name = "ks_dashboard";
        
        // File type magic words for image detection
        this.file_type_magic_word = {
            '/': 'jpg',
            'R': 'gif',
            'i': 'png',
            'P': 'svg+xml',
        };

        // Date filter selections
        this.ks_date_filter_selections = {
            'l_none': _t('Date Filter'),
            'l_day': _t('Today'),
            't_week': _t('This Week'),
            't_month': _t('This Month'),
            't_quarter': _t('This Quarter'),
            't_year': _t('This Year'),
            'n_day': _t('Next Day'),
            'n_week': _t('Next Week'),
            'n_month': _t('Next Month'),
            'n_quarter': _t('Next Quarter'),
            'n_year': _t('Next Year'),
            'ls_day': _t('Last Day'),
            'ls_week': _t('Last Week'),
            'ls_month': _t('Last Month'),
            'ls_quarter': _t('Last Quarter'),
            'ls_year': _t('Last Year'),
            'l_week': _t('Last 7 days'),
            'l_month': _t('Last 30 days'),
            'l_quarter': _t('Last 90 days'),
            'l_year': _t('Last 365 days'),
            'ls_past_until_now': _t('Past Till Now'),
            'ls_pastwithout_now': _t('Past Excluding Today'),
            'n_future_starting_now': _t('Future Starting Now'),
            'n_futurestarting_tomorrow': _t('Future Starting Tomorrow'),
            'l_custom': _t('Custom Filter'),
        };

        // Date filter selection order
        this.ks_date_filter_selection_order = [
            'l_day', 't_week', 't_month', 't_quarter', 't_year', 'n_day',
            'n_week', 'n_month', 'n_quarter', 'n_year', 'ls_day', 'ls_week', 
            'ls_month', 'ls_quarter', 'ls_year', 'l_week', 'l_month', 'l_quarter', 
            'l_year', 'ls_past_until_now', 'ls_pastwithout_now', 
            'n_future_starting_now', 'n_futurestarting_tomorrow', 'l_custom'
        ];

        // GridStack configuration
        this.gridstack_options = {
            staticGrid: true,
            float: false,
            animate: true,
        };
        this.gridstackConfig = {};
        this.grid = false;
        this.chartMeasure = {};
        this.chart_container = {};
        this.list_container = {};

        // Chart color options
        this.ksChartColorOptions = ['default', 'cool', 'warm', 'neon'];
        this.ksUpdateDashboard = {};

        // Date format setup
        this.form_template = 'ks_dashboard_ninja_template_view';
        this.date_format = formatDate.toString();
        this.datetime_format = formatDateTime.toString();

        onWillStart(this.onWillStart);
        onMounted(this.onMounted);
        onWillUnmount(this.onWillUnmount);
    }

    async onWillStart() {
        await this.ks_fetch_items_data();
    }

    onMounted() {
        this.ksRenderDashboard();
        this.ks_set_update_interval();
        if (this.ks_dashboard_data?.ks_item_data) {
            this._ksSaveCurrentLayout();
        }
    }

    onWillUnmount() {
        this.ks_remove_update_interval();
        if (this.state.ksDashboardEditMode) {
            this._ksSaveCurrentLayout();
        }
        this.state.ksDateFilterSelection = false;
        this.state.ksDateFilterStartDate = false;
        this.state.ksDateFilterEndDate = false;
    }

    getContext() {
        const context = {
            ksDateFilterSelection: this.state.ksDateFilterSelection,
            ksDateFilterStartDate: this.state.ksDateFilterStartDate,
            ksDateFilterEndDate: this.state.ksDateFilterEndDate,
        };
        return Object.assign(context, session.user_context);
    }

    async ks_fetch_items_data() {
        try {
            const result = await this.orm.call(
                'ks_dashboard_ninja.board',
                'ks_fetch_dashboard_data',
                [parseInt(this.ks_dashboard_id)],
                { context: this.getContext() }
            );
            this.ks_dashboard_data = result;
            return result;
        } catch (error) {
            console.error('Error fetching dashboard data:', error);
            this.notification.add(_t('Error loading dashboard data'), { type: 'danger' });
        }
    }

    ks_set_update_interval() {
        if (this.ks_dashboard_data?.ks_item_data) {
            Object.keys(this.ks_dashboard_data.ks_item_data).forEach((item_id) => {
                const item_data = this.ks_dashboard_data.ks_item_data[item_id];
                const updateValue = item_data["ks_update_items_data"];
                if (updateValue && !(item_id in this.ksUpdateDashboard)) {
                    let ksItemUpdateInterval;
                    if (['ks_tile', 'ks_list_view', 'ks_kpi'].indexOf(item_data['ks_dashboard_item_type']) >= 0) {
                        ksItemUpdateInterval = setInterval(() => {
                            this.ksFetchUpdateItem(item_id);
                        }, updateValue);
                    } else {
                        ksItemUpdateInterval = setInterval(() => {
                            this.ksFetchChartItem(item_id);
                        }, updateValue);
                    }
                    this.ksUpdateDashboard[item_id] = ksItemUpdateInterval;
                }
            });
        }
    }

    ks_remove_update_interval() {
        if (this.ksUpdateDashboard) {
            Object.values(this.ksUpdateDashboard).forEach((itemInterval) => {
                clearInterval(itemInterval);
            });
            this.ksUpdateDashboard = {};
        }
    }

    ksRenderDashboard() {
        // Dashboard rendering logic will be implemented here
        // This is a placeholder for the extensive rendering logic
        console.log('Rendering dashboard...');
    }

    _ksSaveCurrentLayout() {
        // Layout saving logic will be implemented here
        console.log('Saving current layout...');
    }

    async ksFetchUpdateItem(item_id) {
        // Item update logic will be implemented here
        console.log('Updating item:', item_id);
    }

    async ksFetchChartItem(item_id) {
        // Chart item update logic will be implemented here
        console.log('Updating chart item:', item_id);
    }
}

// Register the component
registry.category("actions").add("ks_dashboard_ninja", KsDashboardNinja);