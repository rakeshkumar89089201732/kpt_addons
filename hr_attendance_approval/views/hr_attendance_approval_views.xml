<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Attendance Approval Form View -->
    <record id="hr_attendance_approval_form_view" model="ir.ui.view">
        <field name="name">hr.attendance.approval.form</field>
        <field name="model">hr.attendance.approval</field>
        <field name="arch" type="xml">
            <form string="Attendance Approval">
                <header>
                    <button name="action_check_in" string="Check In" type="object" 
                            class="btn-primary" 
                            invisible="check_in or state != 'draft'"/>
                    <button name="action_check_out" string="Check Out" type="object" 
                            class="btn-primary" 
                            invisible="not check_in or check_out or state != 'draft'"/>
                    <button name="action_submit" string="Submit for Approval" type="object" 
                            class="btn-primary" 
                            invisible="state != 'draft' or not check_in"/>
                    <button name="action_approve" string="Approve" type="object" 
                            class="btn-success" 
                            invisible="not can_approve or state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object" 
                            class="btn-danger" 
                            invisible="not can_approve or state != 'pending'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                            groups="hr_attendance_approval.group_attendance_approval_admin"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="department_id" readonly="1"/>
                            <field name="manager_id" readonly="1"/>
                            <field name="attendance_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="check_in" readonly="1"/>
                            <field name="check_out" readonly="1"/>
                            <field name="worked_hours" widget="float_time"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="state not in ('pending', 'approved', 'rejected')">
                        <group>
                            <field name="approval_config_id" readonly="1"/>
                            <field name="current_approval_level" readonly="1"/>
                        </group>
                        <group>
                            <field name="next_approver_ids" widget="many2many_tags" readonly="1" invisible="state != 'pending'"/>
                            <field name="can_approve" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="state != 'rejected'">
                        <field name="rejection_reason" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Approval History" name="approval_history" invisible="not approval_line_ids">
                            <field name="approval_line_ids" readonly="1">
                                <tree string="Approval History" create="false" delete="false">
                                    <field name="action_date"/>
                                    <field name="user_id"/>
                                    <field name="action" decoration-success="action == 'approve'" decoration-danger="action == 'reject'"/>
                                    <field name="level_sequence"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Add any notes here..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Daily Approvals (Manager evening screen) -->
    <record id="hr_attendance_approval_daily_approvals_action" model="ir.actions.act_window">
        <field name="name">Daily Approvals</field>
        <field name="res_model">hr.attendance.approval</field>
        <field name="view_mode">tree,kanban,form</field>
        <!-- Odoo loads XML records sequentially; the search view is defined later in this file.
             Keep this action install-safe by not referencing a not-yet-loaded external id. -->
        <!-- <field name="search_view_id" ref="hr_attendance_approval_search_view"/> -->
        <field name="context">{'search_default_today': 1, 'search_default_to_approve': 1, 'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance records to approve today
            </p>
            <p>
                Today's attendance approvals assigned to you will appear here.
            </p>
        </field>
    </record>

    <!-- Attendance Approval Tree View -->
    <record id="hr_attendance_approval_tree_view" model="ir.ui.view">
        <field name="name">hr.attendance.approval.tree</field>
        <field name="model">hr.attendance.approval</field>
        <field name="arch" type="xml">
            <tree string="Attendance Approvals" 
                  decoration-info="state == 'draft'" 
                  decoration-warning="state == 'pending'" 
                  decoration-success="state == 'approved'" 
                  decoration-danger="state == 'rejected'"
                  multi_edit="1">
                <header>
                    <button name="%(hr_attendance_bulk_approve_wizard_action)d" string="Approve Selected" type="action" class="btn-success"/>
                    <button name="%(hr_attendance_bulk_reject_wizard_action)d" string="Reject Selected" type="action" class="btn-danger"/>
                </header>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="attendance_date"/>
                <field name="check_in" widget="datetime"/>
                <field name="check_out" widget="datetime"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'pending'" 
                       decoration-success="state == 'approved'" 
                       decoration-danger="state == 'rejected'"/>
                <field name="next_approver_ids" widget="many2many_tags" optional="hide"/>
                <field name="can_approve" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Attendance Approval Kanban View -->
    <record id="hr_attendance_approval_kanban_view" model="ir.ui.view">
        <field name="name">hr.attendance.approval.kanban</field>
        <field name="model">hr.attendance.approval</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="employee_id"/>
                <field name="attendance_date"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours"/>
                <field name="state"/>
                <field name="can_approve"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="employee_id"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'info', 'pending': 'warning', 'approved': 'success', 'rejected': 'danger'}}"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <strong>Date:</strong> <field name="attendance_date"/>
                                    </div>
                                    <div t-if="record.check_in.raw_value">
                                        <strong>In:</strong> <field name="check_in" widget="datetime"/>
                                    </div>
                                    <div t-if="record.check_out.raw_value">
                                        <strong>Out:</strong> <field name="check_out" widget="datetime"/>
                                    </div>
                                    <div>
                                        <strong>Hours:</strong> <field name="worked_hours" widget="float_time"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom" t-if="record.can_approve.raw_value and record.state.raw_value == 'pending'">
                                    <div class="oe_kanban_bottom_left">
                                        <button name="action_approve" type="object" class="btn btn-sm btn-success">Approve</button>
                                        <button name="action_reject" type="object" class="btn btn-sm btn-danger ms-1">Reject</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Attendance Approval Calendar View -->
    <record id="hr_attendance_approval_calendar_view" model="ir.ui.view">
        <field name="name">hr.attendance.approval.calendar</field>
        <field name="model">hr.attendance.approval</field>
        <field name="arch" type="xml">
            <calendar string="Attendance Calendar" date_start="attendance_date" color="state" mode="month" quick_create="0">
                <field name="employee_id"/>
                <field name="state"/>
                <field name="worked_hours"/>
            </calendar>
        </field>
    </record>

    <!-- Attendance Approval Search View -->
    <record id="hr_attendance_approval_search_view" model="ir.ui.view">
        <field name="name">hr.attendance.approval.search</field>
        <field name="model">hr.attendance.approval</field>
        <field name="arch" type="xml">
            <search string="Search Attendance Approvals">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="manager_id"/>
                <field name="attendance_date"/>
                <filter string="My Attendance" name="my_attendance" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="My Team" name="my_team" domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('attendance_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('attendance_date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('attendance_date', '&gt;=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Approval" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="To Approve" name="to_approve" domain="[('next_approver_ids', 'in', uid), ('state', '=', 'pending')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'attendance_date'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Attendance Approval Line Tree View -->
    <record id="hr_attendance_approval_line_tree_view" model="ir.ui.view">
        <field name="name">hr.attendance.approval.line.tree</field>
        <field name="model">hr.attendance.approval.line</field>
        <field name="arch" type="xml">
            <tree string="Approval History" create="false" delete="false" edit="false">
                <field name="attendance_approval_id"/>
                <field name="action_date"/>
                <field name="user_id"/>
                <field name="action" decoration-success="action == 'approve'" decoration-danger="action == 'reject'"/>
                <field name="level_sequence"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <!-- Rejection Wizard Form View -->
    <record id="hr_attendance_rejection_wizard_form_view" model="ir.ui.view">
        <field name="name">hr.attendance.rejection.wizard.form</field>
        <field name="model">hr.attendance.rejection.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Attendance">
                <group>
                    <field name="attendance_approval_id" readonly="1"/>
                    <field name="rejection_reason" placeholder="Please provide a reason for rejection..."/>
                </group>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Actions -->
    
    <!-- All Attendance Approvals -->
    <record id="hr_attendance_approval_action" model="ir.actions.act_window">
        <field name="name">All Attendance</field>
        <field name="res_model">hr.attendance.approval</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="search_view_id" ref="hr_attendance_approval_search_view"/>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance records found
            </p>
        </field>
    </record>

    <!-- My Attendance -->
    <record id="hr_attendance_approval_my_action" model="ir.actions.act_window">
        <field name="name">My Attendance</field>
        <field name="res_model">hr.attendance.approval</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="search_view_id" ref="hr_attendance_approval_search_view"/>
        <field name="context">{'search_default_my_attendance': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first attendance record
            </p>
            <p>
                Check in and check out to track your daily attendance.
            </p>
        </field>
    </record>

    <!-- To Approve (Manager view) -->
    <record id="hr_attendance_approval_to_approve_action" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">hr.attendance.approval</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="hr_attendance_approval_search_view"/>
        <field name="context">{'search_default_to_approve': 1, 'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No attendance records to approve
            </p>
            <p>
                Attendance records pending your approval will appear here.
            </p>
        </field>
    </record>

    <!-- Team Attendance (Manager view) -->
    <record id="hr_attendance_approval_team_action" model="ir.actions.act_window">
        <field name="name">Team Attendance</field>
        <field name="res_model">hr.attendance.approval</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="search_view_id" ref="hr_attendance_approval_search_view"/>
        <field name="context">{'search_default_my_team': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No team attendance records found
            </p>
        </field>
    </record>

</odoo>
