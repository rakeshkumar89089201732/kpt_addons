<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Approval Configuration -->
        <record id="default_attendance_approval_config" model="hr.attendance.approval.config">
            <field name="name">Default Attendance Approval</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Default Approval Level: Direct Manager -->
        <record id="default_approval_level_manager" model="hr.attendance.approval.level">
            <field name="name">Manager Approval</field>
            <field name="sequence">10</field>
            <field name="config_id" ref="default_attendance_approval_config"/>
            <field name="approver_type">manager</field>
            <field name="can_reject" eval="True"/>
        </record>

    </data>
</odoo>
