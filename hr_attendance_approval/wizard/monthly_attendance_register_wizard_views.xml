<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_monthly_attendance_register_wizard_form_view" model="ir.ui.view">
        <field name="name">hr.monthly.attendance.register.wizard.form</field>
        <field name="model">hr.monthly.attendance.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Monthly Attendance Register">
                <field name="state" invisible="1"/>
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="month"/>
                        <field name="year"/>
                    </group>
                    <group>
                        <field name="scope"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </group>

                <group invisible="state != 'done'">
                    <field name="output_file" readonly="1" filename="output_file_name"/>
                    <field name="output_file_name" invisible="1"/>
                </group>

                <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_download" string="Download" type="object" class="btn-success" invisible="state != 'done'"/>
                    <button name="action_new" string="Generate Another" type="object" class="btn-secondary" invisible="state != 'done'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_monthly_attendance_register_wizard_action" model="ir.actions.act_window">
        <field name="name">Monthly Attendance Register</field>
        <field name="res_model">hr.monthly.attendance.register.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>
