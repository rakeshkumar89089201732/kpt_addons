<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_apply_tds_wizard_form" model="ir.ui.view">
        <field name="name">apply.tds.wizard.form</field>
        <field name="model">apply.tds.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply TDS Taxes">
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="tds_tax_ids" widget="many2many_tags" 
                           options="{'no_create': True}"
                           placeholder="Select TDS taxes to apply..."/>
                </group>
                <footer>
                    <button string="Apply TDS" name="action_apply_tds" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
