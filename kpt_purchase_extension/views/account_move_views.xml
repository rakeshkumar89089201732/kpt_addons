<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_kpt_purchase" model="ir.ui.view">
        <field name="name">account.move.form.inherit.kpt.purchase</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_receipt" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-truck"
                        invisible="not has_receipt or move_type != 'in_invoice'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">View</span>
                        <span class="o_stat_text">Receipt</span>
                    </div>
                </button>
            </xpath>

            <!-- Add Apply TDS button after Journal field -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <button name="action_apply_tds" 
                        type="object" 
                        string="Apply TDS"
                        class="oe_link"
                        invisible="state != 'draft' or move_type != 'in_invoice'"/>
            </xpath>

            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="receipt_id" 
                       invisible="move_type != 'in_invoice'"
                       readonly="state != 'draft'"/>
                <field name="auto_created_receipt_id" 
                       invisible="1"/>
                <field name="has_receipt" invisible="1"/>
            </xpath>

            <!-- Add Total Amount input field in vendor bill lines after quantity -->
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="after">
                <field name="total_amount_input" 
                       string="Total Amt"
                       optional="show"
                       column_invisible="parent.move_type != 'in_invoice'"/>
            </xpath>
            
        </field>
    </record>
</odoo>
