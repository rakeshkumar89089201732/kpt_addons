<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_company_form_kpt_purchase_rounding" model="ir.ui.view">
            <field name="name">res.company.form.kpt.purchase.rounding</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='general_info']//group//field[@name='currency_id']" position="after">
                    <field name="purchase_cash_rounding_id" options="{'no_create': False}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
