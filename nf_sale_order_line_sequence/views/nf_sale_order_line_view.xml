<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="nf_sale_order_line_sequence_form_view" model="ir.ui.view">
        <field name="name">sale_order_line_sequence.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree/field[@name='sequence']" position="before">
                <field name="nf_number" string="#" readonly="1" width="40px"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                <attribute name="width">320px</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
</odoo>