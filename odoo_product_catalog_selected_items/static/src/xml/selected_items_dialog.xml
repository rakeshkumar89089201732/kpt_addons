<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odoo_product_catalog_selected_items.SelectedItemsDialog">
        <Dialog title="'Selected Products'" onClose="props.close">
            <div class="o_selected_items_content p-3">
                <t t-if="state.loading">
                    <div class="text-center">
                        <i class="fa fa-spinner fa-spin fa-2x"/> Loading...
                    </div>
                </t>
                <t t-else="">
                    <t t-if="state.lines.length === 0">
                        <div class="text-center text-muted">
                            No items selected yet.
                        </div>
                    </t>
                    <t t-else="">
                        <div class="table-responsive">
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">SL No</th>
                                        <th>Product</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.lines" t-as="line" t-key="line.id">
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td><t t-esc="line.product_name"/></td>
                                        <td class="text-end"><t t-esc="line.quantity"/></td>
                                        <td class="text-end"><t t-esc="formatMoney(line.price)"/></td>
                                        <td class="text-end fw-bold"><t t-esc="formatMoney(line.subtotal)"/></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="fw-bold">
                                        <td colspan="4" class="text-end">Total:</td>
                                        <td class="text-end"><t t-esc="formatMoney(state.total)"/></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </t>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>
</templates>
