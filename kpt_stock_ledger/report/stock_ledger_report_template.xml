<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Stock Ledger Report Template -->
    <template id="stock_ledger_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Stock Ledger Report</h2>
                    <div class="row mt-4 mb-4">
                        <div class="col-6">
                            <strong>Product:</strong> <span t-field="docs.product_id.name"/>
                        </div>
                        <div class="col-6">
                            <strong>Period:</strong> <span t-esc="date_from"/> to <span t-esc="date_to"/>
                        </div>
                    </div>
                    
                    <table class="table table-sm">
                        <thead>
                            <tr style="background-color: #875A7B; color: white;">
                                <th>Date</th>
                                <th>Particulars</th>
                                <th>Vch Type</th>
                                <th>Vch No</th>
                                <th class="text-end">Inward Qty</th>
                                <th class="text-end">Inward Value</th>
                                <th class="text-end">Outward Qty</th>
                                <th class="text-end">Outward Value</th>
                                <th class="text-end">Closing Qty</th>
                                <th class="text-end">Closing Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="line">
                                <tr>
                                    <td><span t-field="line.date"/></td>
                                    <td><span t-field="line.particulars"/></td>
                                    <td><span t-field="line.vch_type"/></td>
                                    <td><span t-field="line.vch_no"/></td>
                                    <td class="text-end"><span t-field="line.inward_qty"/></td>
                                    <td class="text-end"><span t-field="line.inward_value"/></td>
                                    <td class="text-end"><span t-field="line.outward_qty"/></td>
                                    <td class="text-end"><span t-field="line.outward_value"/></td>
                                    <td class="text-end"><span t-field="line.closing_qty"/></td>
                                    <td class="text-end"><span t-field="line.closing_value"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
