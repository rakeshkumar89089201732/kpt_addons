<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Stock Ledger Tree View -->
    <record id="view_stock_ledger_tree" model="ir.ui.view">
        <field name="name">stock.ledger.tree</field>
        <field name="model">stock.ledger</field>
        <field name="arch" type="xml">
            <tree string="Stock Ledger" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="particulars"/>
                <field name="vch_type"/>
                <field name="vch_no"/>
                <field name="inward_qty" sum="Total Inward Qty"/>
                <field name="inward_value" sum="Total Inward Value"/>
                <field name="inward_rate" optional="hide"/>
                <field name="outward_qty" sum="Total Outward Qty"/>
                <field name="outward_value" sum="Total Outward Value"/>
                <field name="outward_rate" optional="hide"/>
                <field name="closing_qty"/>
                <field name="closing_value"/>
                <field name="closing_rate" optional="hide"/>
                <field name="uom_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Stock Ledger Form View -->
    <record id="view_stock_ledger_form" model="ir.ui.view">
        <field name="name">stock.ledger.form</field>
        <field name="model">stock.ledger</field>
        <field name="arch" type="xml">
            <form string="Stock Ledger Entry" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="product_id"/>
                            <field name="particulars"/>
                            <field name="partner_id"/>
                            <field name="vch_type"/>
                            <field name="vch_no"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="uom_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                            <field name="stock_move_id"/>
                        </group>
                    </group>
                    <group string="Inwards">
                        <group>
                            <field name="inward_qty"/>
                            <field name="inward_value"/>
                            <field name="inward_rate"/>
                        </group>
                    </group>
                    <group string="Outwards">
                        <group>
                            <field name="outward_qty"/>
                            <field name="outward_value"/>
                            <field name="outward_rate"/>
                        </group>
                    </group>
                    <group string="Closing Balance">
                        <group>
                            <field name="closing_qty"/>
                            <field name="closing_value"/>
                            <field name="closing_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stock Ledger Search View -->
    <record id="view_stock_ledger_search" model="ir.ui.view">
        <field name="name">stock.ledger.search</field>
        <field name="model">stock.ledger</field>
        <field name="arch" type="xml">
            <search string="Stock Ledger">
                <field name="product_id"/>
                <field name="particulars"/>
                <field name="partner_id"/>
                <field name="vch_no"/>
                <field name="date"/>
                <filter string="Opening Balance" name="opening" domain="[('vch_type', '=', 'opening')]"/>
                <filter string="Sales" name="sales" domain="[('vch_type', '=', 'sales')]"/>
                <filter string="Purchase" name="purchase" domain="[('vch_type', '=', 'purchase')]"/>
                <filter string="Stock Journal" name="stock_journal" domain="[('vch_type', '=', 'stock_journal')]"/>
                <separator/>
                <filter string="This Month" name="this_month" 
                        domain="[('date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Year" name="this_year" 
                        domain="[('date', '&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d')),
                                 ('date', '&lt;=', (context_today() + relativedelta(month=12, day=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Voucher Type" name="group_vch_type" context="{'group_by': 'vch_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Stock Ledger Action -->
    <record id="action_stock_ledger" model="ir.actions.act_window">
        <field name="name">Stock Ledger</field>
        <field name="res_model">stock.ledger</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_stock_ledger_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No stock ledger entries found
            </p>
            <p>
                Use the "Generate Stock Ledger" wizard to create ledger entries for a product.
            </p>
        </field>
    </record>
</odoo>
