<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_warranty_user" model="res.groups">
        <field name="name">Warranty User</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_warranty_manager" model="res.groups">
        <field name="name">Warranty Manager</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_warranty_user'))]"/>
    </record>

    <record id="model_product_warranty" model="ir.model">
        <field name="name">product.warranty</field>
        <field name="model">product.warranty</field>
    </record>

    <record id="model_product_warranty_claim" model="ir.model">
        <field name="name">product.warranty.claim</field>
        <field name="model">product.warranty.claim</field>
    </record>

    <record id="model_product_warranty_renewal" model="ir.model">
        <field name="name">product.warranty.renewal</field>
        <field name="model">product.warranty.renewal</field>
    </record>

    <record id="ir_rule_warranty_user" model="ir.rule">
        <field name="name">Warranty: User Access</field>
        <field name="model_id" ref="model_product_warranty"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_warranty_user'))]"/>
    </record>

    <record id="ir_rule_warranty_claim_user" model="ir.rule">
        <field name="name">Warranty Claim: User Access</field>
        <field name="model_id" ref="model_product_warranty_claim"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_warranty_user'))]"/>
    </record>

    <record id="ir_rule_warranty_renewal_user" model="ir.rule">
        <field name="name">Warranty Renewal: User Access</field>
        <field name="model_id" ref="model_product_warranty_renewal"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_warranty_user'))]"/>
    </record>
</odoo>
