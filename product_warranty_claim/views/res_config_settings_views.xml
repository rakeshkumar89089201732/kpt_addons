<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_warranty" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.warranty</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Warranty" string="Warranty" name="product_warranty_claim">
                    <block title="Warranty Settings">
                        <setting string="Auto-create Invoice for Paid Warranties" help="Automatically create invoices when paid warranties are generated from sales orders">
                            <field name="auto_create_warranty_invoice"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
