<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_warranty" model="ir.ui.view">
        <field name="name">sale.order.form.warranty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']" position="after">
                <field name="warranty_id" readonly="1" optional="hide"/>
            </xpath>
            <xpath expr="//form//header" position="inside">
                <button name="action_create_warranties" string="Create Warranties" type="object" class="oe_highlight" invisible="state not in ['sale', 'done']"/>
            </xpath>
            <xpath expr="//form//div[@name='button_box']//button[@name='action_view_invoice']" position="after">
                <button name="action_view_warranties" type="object" class="oe_stat_button" icon="fa-shield" invisible="warranty_count == 0">
                    <field name="warranty_count" widget="statinfo" string="Warranties"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
