<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_warranty" model="ir.ui.view">
        <field name="name">product.template.form.warranty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <group>
                    <group string="Warranty">
                        <field name="has_warranty"/>
                        <field name="warranty_type" invisible="not has_warranty"/>
                        <field name="warranty_period" invisible="not has_warranty"/>
                        <field name="warranty_price" invisible="not has_warranty or warranty_type != 'paid'"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='description']" position="after">
                <button name="action_view_warranties" type="object" class="oe_stat_button" icon="fa-shield" invisible="not has_warranty">
                    <field name="warranty_count" widget="statinfo" string="Warranties"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
