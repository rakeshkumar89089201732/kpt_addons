<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_warranty_claim_tree" model="ir.ui.view">
        <field name="name">product.warranty.claim.tree</field>
        <field name="model">product.warranty.claim</field>
        <field name="arch" type="xml">
            <tree string="Warranty Claims" decoration-danger="is_within_warranty == False" decoration-success="state == 'resolved'">
                <field name="name"/>
                <field name="warranty_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="claim_date"/>
                <field name="claim_type"/>
                <field name="state" widget="badge" decoration-success="state == 'resolved'" decoration-danger="state == 'rejected'"/>
                <field name="is_within_warranty" invisible="1"/>
                <field name="cost"/>
            </tree>
        </field>
    </record>

    <record id="view_product_warranty_claim_form" model="ir.ui.view">
        <field name="name">product.warranty.claim.form</field>
        <field name="model">product.warranty.claim</field>
        <field name="arch" type="xml">
            <form string="Warranty Claim">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start_progress" string="Start Progress" type="object" invisible="state != 'submitted'"/>
                    <button name="action_resolve" string="Resolve" type="object" class="oe_highlight" invisible="state not in ['submitted', 'in_progress']"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state not in ['submitted', 'in_progress']"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['resolved', 'rejected', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,in_progress,resolved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="warranty_id" options="{'no_create': True}"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="serial_number" readonly="1"/>
                        </group>
                        <group>
                            <field name="claim_date"/>
                            <field name="claim_type"/>
                            <field name="state"/>
                            <field name="is_within_warranty" readonly="1"/>
                            <field name="assigned_to"/>
                            <field name="cost"/>
                            <field name="resolution_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="issue_description" placeholder="Describe the issue or problem..."/>
                        <field name="resolution" placeholder="Enter resolution details..."/>
                        <field name="note" placeholder="Add internal notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_product_warranty_claim_search" model="ir.ui.view">
        <field name="name">product.warranty.claim.search</field>
        <field name="model">product.warranty.claim</field>
        <field name="arch" type="xml">
            <search string="Search Warranty Claims">
                <field name="name"/>
                <field name="warranty_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="serial_number"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Resolved" name="resolved" domain="[('state', '=', 'resolved')]"/>
                <filter string="Within Warranty" name="within_warranty" domain="[('is_within_warranty', '=', True)]"/>
                <filter string="Outside Warranty" name="outside_warranty" domain="[('is_within_warranty', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Claim Type" name="group_type" context="{'group_by': 'claim_type'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_warranty_claim" model="ir.actions.act_window">
        <field name="name">Warranty Claims</field>
        <field name="res_model">product.warranty.claim</field>
        <field name="view_mode">tree,form,graph,pivot</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first warranty claim!
            </p>
            <p>
                Warranty claims can be created for active warranties to track issues and resolutions.
            </p>
        </field>
    </record>
</odoo>
