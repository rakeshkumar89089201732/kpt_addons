<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Print Buttons -->
    <record id="view_order_form_inherit_print_buttons" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.print.buttons</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_quotation_copies" 
                        string="Print Quotation" 
                        type="object" 
                        class="btn-primary"
                        invisible="state not in ['draft', 'sent']"/>
                <button name="action_print_proforma_copies" 
                        string="Print Pro-Forma" 
                        type="object" 
                        class="btn-primary"
                        groups="sale.group_proforma_sales"/>
                <button name="action_print_proforma_dispatch_copies" 
                        string="Print Pro-Forma (Dispatch)" 
                        type="object" 
                        class="btn-primary"
                        groups="sale.group_proforma_sales"/>
            </xpath>
        </field>
    </record>

    <!-- Stock Picking Print Buttons -->
    <record id="view_picking_form_inherit_print_buttons" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.print.buttons</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_delivery_challan_copies" 
                        string="Print Delivery Challan" 
                        type="object" 
                        class="btn-primary"/>
                <button name="action_print_delivery_note_copies" 
                        string="Print Delivery Note" 
                        type="object" 
                        class="btn-secondary"/>
                <button name="action_print_delivery_note_sample_copies" 
                        string="Print Delivery Note (Sample)" 
                        type="object" 
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Print Buttons -->
    <record id="view_purchase_order_form_inherit_print_buttons" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.print.buttons</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_purchase_order_copies" 
                        string="Print Purchase Order" 
                        type="object" 
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <!-- Account Move Print Buttons -->
    <record id="view_move_form_inherit_print_buttons" model="ir.ui.view">
        <field name="name">account.move.form.inherit.print.buttons</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_tax_invoice_copies" 
                        string="Print Tax Invoice" 
                        type="object" 
                        class="btn-primary"
                        invisible="move_type not in ['out_invoice', 'out_refund']"/>
            </xpath>
        </field>
    </record>
</odoo>
