<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Default Global Shortcuts -->
        
        <!-- Enter for Next Field (Global) -->
        <record id="shortcut_enter_next_field" model="keyboard.shortcut">
            <field name="name">Enter - Next Field</field>
            <field name="sequence">10</field>
            <field name="key_code">Enter</field>
            <field name="ctrl_key" eval="False"/>
            <field name="alt_key" eval="False"/>
            <field name="shift_key" eval="False"/>
            <field name="meta_key" eval="False"/>
            <field name="action_id" ref="action_next_field"/>
            <field name="scope">global</field>
            <field name="apply_on_view">form</field>
            <field name="active" eval="True"/>
            <field name="is_system" eval="True"/>
            <field name="description">Press Enter to move to the next field in forms</field>
            <field name="prevent_default" eval="True"/>
        </record>

        <!-- Ctrl+Enter for New Line -->
        <record id="shortcut_ctrl_enter_newline" model="keyboard.shortcut">
            <field name="name">Ctrl+Enter - New Line</field>
            <field name="sequence">20</field>
            <field name="key_code">Enter</field>
            <field name="ctrl_key" eval="True"/>
            <field name="alt_key" eval="False"/>
            <field name="shift_key" eval="False"/>
            <field name="meta_key" eval="False"/>
            <field name="action_id" ref="action_new_line"/>
            <field name="scope">global</field>
            <field name="apply_on_view">form</field>
            <field name="active" eval="True"/>
            <field name="is_system" eval="True"/>
            <field name="description">Press Ctrl+Enter to insert a new line in text fields</field>
            <field name="prevent_default" eval="True"/>
        </record>

        <!-- Ctrl+S for Save -->
        <record id="shortcut_ctrl_s_save" model="keyboard.shortcut">
            <field name="name">Ctrl+S - Save</field>
            <field name="sequence">30</field>
            <field name="key_code">s</field>
            <field name="ctrl_key" eval="True"/>
            <field name="alt_key" eval="False"/>
            <field name="shift_key" eval="False"/>
            <field name="meta_key" eval="False"/>
            <field name="action_id" ref="action_save_record"/>
            <field name="scope">global</field>
            <field name="apply_on_view">form</field>
            <field name="active" eval="True"/>
            <field name="is_system" eval="True"/>
            <field name="description">Press Ctrl+S to save the current record</field>
            <field name="prevent_default" eval="True"/>
        </record>

        <!-- Ctrl+N for New Record -->
        <record id="shortcut_ctrl_n_create" model="keyboard.shortcut">
            <field name="name">Ctrl+N - New Record</field>
            <field name="sequence">40</field>
            <field name="key_code">n</field>
            <field name="ctrl_key" eval="True"/>
            <field name="alt_key" eval="False"/>
            <field name="shift_key" eval="False"/>
            <field name="meta_key" eval="False"/>
            <field name="action_id" ref="action_create_record"/>
            <field name="scope">global</field>
            <field name="apply_on_view">all</field>
            <field name="active" eval="True"/>
            <field name="is_system" eval="True"/>
            <field name="description">Press Ctrl+N to create a new record</field>
            <field name="prevent_default" eval="True"/>
        </record>

        <!-- Escape to Close Dialog -->
        <record id="shortcut_esc_close" model="keyboard.shortcut">
            <field name="name">Escape - Close</field>
            <field name="sequence">50</field>
            <field name="key_code">Escape</field>
            <field name="ctrl_key" eval="False"/>
            <field name="alt_key" eval="False"/>
            <field name="shift_key" eval="False"/>
            <field name="meta_key" eval="False"/>
            <field name="action_id" ref="action_close_dialog"/>
            <field name="scope">global</field>
            <field name="apply_on_view">all</field>
            <field name="active" eval="True"/>
            <field name="is_system" eval="True"/>
            <field name="description">Press Escape to close dialogs</field>
            <field name="prevent_default" eval="False"/>
        </record>

        <!-- Ctrl+E for Edit -->
        <record id="shortcut_ctrl_e_edit" model="keyboard.shortcut">
            <field name="name">Ctrl+E - Edit</field>
            <field name="sequence">60</field>
            <field name="key_code">e</field>
            <field name="ctrl_key" eval="True"/>
            <field name="alt_key" eval="False"/>
            <field name="shift_key" eval="False"/>
            <field name="meta_key" eval="False"/>
            <field name="action_id" ref="action_edit_record"/>
            <field name="scope">global</field>
            <field name="apply_on_view">form</field>
            <field name="active" eval="True"/>
            <field name="is_system" eval="True"/>
            <field name="description">Press Ctrl+E to edit the current record</field>
            <field name="prevent_default" eval="True"/>
        </record>

        <!-- Ctrl+D for Duplicate -->
        <record id="shortcut_ctrl_d_duplicate" model="keyboard.shortcut">
            <field name="name">Ctrl+D - Duplicate</field>
            <field name="sequence">70</field>
            <field name="key_code">d</field>
            <field name="ctrl_key" eval="True"/>
            <field name="alt_key" eval="False"/>
            <field name="shift_key" eval="False"/>
            <field name="meta_key" eval="False"/>
            <field name="action_id" ref="action_duplicate_record"/>
            <field name="scope">global</field>
            <field name="apply_on_view">form</field>
            <field name="active" eval="True"/>
            <field name="is_system" eval="True"/>
            <field name="description">Press Ctrl+D to duplicate the current record</field>
            <field name="prevent_default" eval="True"/>
        </record>

        <!-- Ctrl+F for Search -->
        <record id="shortcut_ctrl_f_search" model="keyboard.shortcut">
            <field name="name">Ctrl+F - Search</field>
            <field name="sequence">80</field>
            <field name="key_code">f</field>
            <field name="ctrl_key" eval="True"/>
            <field name="alt_key" eval="False"/>
            <field name="shift_key" eval="False"/>
            <field name="meta_key" eval="False"/>
            <field name="action_id" ref="action_search_focus"/>
            <field name="scope">global</field>
            <field name="apply_on_view">list</field>
            <field name="active" eval="True"/>
            <field name="is_system" eval="True"/>
            <field name="description">Press Ctrl+F to focus on search</field>
            <field name="prevent_default" eval="True"/>
        </record>

    </data>
</odoo>
