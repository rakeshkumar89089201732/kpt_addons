<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Extend User Form View -->
    <record id="view_users_form_shortcuts" model="ir.ui.view">
        <field name="name">res.users.form.shortcuts</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Keyboard Shortcuts" name="keyboard_shortcuts"
                      groups="base.group_system">
                    <group>
                        <group>
                            <field name="enable_shortcuts"/>
                        </group>
                        <group>
                            <button name="action_view_shortcuts" type="object" 
                                    string="View My Shortcuts" class="btn-primary" icon="fa-keyboard-o"/>
                            <button name="action_reset_shortcuts" type="object" 
                                    string="Reset to Defaults" class="btn-secondary" icon="fa-refresh"
                                    confirm="This will delete all your personal shortcuts. Are you sure?"/>
                        </group>
                    </group>
                    <group>
                        <field name="shortcut_ids" nolabel="1" context="{'default_user_id': active_id, 'default_scope': 'user'}">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="shortcut_display"/>
                                <field name="action_id"/>
                                <field name="apply_on_view"/>
                                <field name="active" widget="boolean_toggle"/>
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend User Preferences Form -->
    <record id="view_users_form_simple_modif_shortcuts" model="ir.ui.view">
        <field name="name">res.users.form.simple.shortcuts</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="inside">
                <field name="enable_shortcuts"/>
            </xpath>
        </field>
    </record>

</odoo>
