<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Security Groups -->
        <record id="group_shortcut_user" model="res.groups">
            <field name="name">Keyboard Shortcuts User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_shortcut_manager" model="res.groups">
            <field name="name">Keyboard Shortcuts Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_shortcut_user'))]"/>
        </record>

        <!-- Restrict shortcut management to administrators -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(3, ref('group_shortcut_user'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_shortcut_manager'))]"/>
        </record>

        <!-- Record Rules for keyboard.shortcut -->
        <record id="keyboard_shortcut_user_rule" model="ir.rule">
            <field name="name">User can see own and global shortcuts</field>
            <field name="model_id" ref="model_keyboard_shortcut"/>
            <field name="domain_force">[
                '|',
                    ('scope', '=', 'global'),
                    ('user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_shortcut_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="keyboard_shortcut_user_write_rule" model="ir.rule">
            <field name="name">User can edit own shortcuts</field>
            <field name="model_id" ref="model_keyboard_shortcut"/>
            <field name="domain_force">[
                ('user_id', '=', user.id),
                ('is_system', '=', False)
            ]</field>
            <field name="groups" eval="[(4, ref('group_shortcut_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="keyboard_shortcut_manager_rule" model="ir.rule">
            <field name="name">Manager can manage all shortcuts</field>
            <field name="model_id" ref="model_keyboard_shortcut"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shortcut_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Record Rules for shortcut.action -->
        <record id="shortcut_action_user_rule" model="ir.rule">
            <field name="name">All users can read actions</field>
            <field name="model_id" ref="model_shortcut_action"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shortcut_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="shortcut_action_manager_rule" model="ir.rule">
            <field name="name">Manager can manage actions</field>
            <field name="model_id" ref="model_shortcut_action"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_shortcut_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
