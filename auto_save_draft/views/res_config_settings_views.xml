<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_auto_save_draft" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auto_save_draft</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="inside">
                <block title="Autosave Draft" name="auto_save_draft_block">
                    <setting id="auto_save_draft_enabled_setting" string="Autosave Draft" help="Automatically saves draft Sales Orders and Transfers while you work.">
                        <field name="auto_save_draft_enabled"/>
                        <div class="content-group" invisible="not auto_save_draft_enabled">
                            <div class="row mt16">
                                <label for="auto_save_draft_initial_delay_ms" class="col-4 col-lg-3 o_light_label" string="Initial Delay (ms)"/>
                                <field name="auto_save_draft_initial_delay_ms" class="w-auto"/>
                            </div>
                            <div class="row mt16">
                                <label for="auto_save_draft_regular_interval_ms" class="col-4 col-lg-3 o_light_label" string="Interval (ms)"/>
                                <field name="auto_save_draft_regular_interval_ms" class="w-auto"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

