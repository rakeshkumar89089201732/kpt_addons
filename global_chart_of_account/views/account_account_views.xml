<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form_inherit_kpt" model="ir.ui.view">
        <field name="name">account.account.form.inherit.kpt</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="user_type_id" widget="selection"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_list_inherit_kpt" model="ir.ui.view">
        <field name="name">account.account.list.inherit.kpt</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_type']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='account_type']" position="after">
                <field name="user_type_id" widget="selection" string="Type"/>
            </xpath>
        </field>
    </record>
    
    <!-- Also update the search view if needed, but for now specific requirement was for forms/list -->
</odoo>
