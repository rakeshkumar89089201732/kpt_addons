<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Action to download user import sample CSV -->
        <record id="action_download_user_import_sample" model="ir.actions.act_url">
            <field name="name">Download User Import Sample</field>
            <field name="url">/user_data_import_export/download_sample</field>
            <field name="target">self</field>
            <field name="help">Download a sample CSV file with the correct format for importing users. Use this template to prepare your user data. Access rights (groups) can be set via the groups_id/id column using comma-separated external IDs (e.g. base.group_user,base.group_partner_manager).</field>
        </record>

        <!-- Menu under Settings > Users & Companies: visible to users with User Data Export/Import group -->
        <menuitem id="menu_download_user_import_sample"
            name="Download User Import Sample"
            action="action_download_user_import_sample"
            parent="base.menu_users"
            groups="user_data_import_export.group_user_import_export"
            sequence="5"/>
    </data>
</odoo>
