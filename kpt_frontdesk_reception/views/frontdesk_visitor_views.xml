<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kpt_frontdesk_visitor_view_form" model="ir.ui.view">
        <field name="name">frontdesk.visitor.view.form.kpt.selfie</field>
        <field name="model">frontdesk.visitor</field>
        <field name="inherit_id" ref="frontdesk.frontdesk_visitor_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[2]" position="inside">
                <field name="selfie_image" widget="image" class="oe_avatar"/>
            </xpath>
        </field>
    </record>
</odoo>
